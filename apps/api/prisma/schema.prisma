// POD — vehicle import & delivery tracking platform
// Core design rule: the spreadsheet tangled four independent facts into one
// cell. Here they are modelled separately:
//   1. Lead stage      -> Deal.leadStage (pre-sale funnel, nullable once a deal)
//   2. Deal status     -> Deal.currentStatus + STATUS_CHANGE timeline events
//   3. Location        -> Deal.currentLocation + LOCATION_CHANGE timeline events
//   4. Payment status  -> derived from Payment rows, never a free-text guess
// The TimelineEvent table is append-only and doubles as the audit log.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  OWNER
  ADMIN
  CONSULTANT
  VIEWER
}

enum LeadStage {
  STILL_LOOKING
  VALUATION_REQUESTED
  PREVIEWS_SENT
  AUCTION_IN_PROGRESS
  ON_HOLD
  CLOSED_WON
  CLOSED_LOST
}

enum TimelineType {
  STATUS_CHANGE
  LOCATION_CHANGE
  NOTE
  PAYMENT
  DOCUMENT
  MEDIA
  SYSTEM
}

enum MediaKind {
  PHOTO
  VIDEO
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum DocumentType {
  NATIS
  POLICE_CLEARANCE
  ITAC
  CBCA
  SAD500
  BILL_OF_LADING
  SUPPLIER_INVOICE
  SALES_INVOICE
  OTHER
}

enum ImportBatchStatus {
  UPLOADED
  MAPPING
  REVIEW
  COMMITTED
  ABANDONED
}

enum ImportRowStatus {
  PENDING
  NEEDS_REVIEW
  RESOLVED
  COMMITTED
  SKIPPED
}

enum NotificationChannel {
  WHATSAPP
  INTERNAL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  LOGGED // stub provider: recorded but not actually sent
  SKIPPED // e.g. no phone number / not opted in
}

// ─────────────────────────── Staff & clients ───────────────────────────

model User {
  id           String   @id @default(cuid())
  keycloakId   String?  @unique // linked on first login; seeded users link later
  username     String?  @unique // local auth credential
  passwordHash String? // bcrypt; null = cannot log in
  fullName     String
  email        String?  @unique
  role         Role     @default(CONSULTANT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dealsResponsible Deal[]          @relation("ConsultantDeals")
  timelineEvents   TimelineEvent[]
  payments         Payment[]
  mediaUploads     MediaAsset[]
  importBatches    ImportBatch[]
}

model Client {
  id                String   @id @default(cuid())
  fullName          String
  phoneE164         String? // normalised to E.164 so WhatsApp works; deduped by importer
  altPhone          String?
  email             String?
  country           String?
  city              String?
  preferredLanguage String   @default("en")
  whatsappOptIn     Boolean  @default(false)
  notes             String?
  sageContactId     String? // Sage Business Cloud contact id, set on first push
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  deals           Deal[]
  trackingLinks   TrackingLink[]
  notifications   Notification[]
  inboundMessages InboundMessage[]

  @@index([phoneE164])
  @@index([fullName])
}

// ─────────────────────── Reference data (from Sheet2) ───────────────────────
// Lookup tables rather than enums: POD's own status/location lists are seeded
// by the importer from their spreadsheet and stay editable by admins.

model DealStatus {
  id         String  @id @default(cuid())
  name       String  @unique
  sortOrder  Int     @default(0)
  isTerminal Boolean @default(false) // e.g. Delivered / Completed
  active     Boolean @default(true)

  dealsCurrent   Deal[]          @relation("CurrentStatus")
  timelineEvents TimelineEvent[]
}

model Location {
  id        String  @id @default(cuid())
  name      String  @unique
  country   String?
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  dealsCurrent   Deal[]          @relation("CurrentLocation")
  timelineEvents TimelineEvent[]
}

// ─────────────────────────────── The deal ───────────────────────────────
// MVP decision: vehicle fields live on Deal (one car = one deal in POD's
// business). Split into a separate Vehicle table only if resale/reuse of the
// same car across deals ever becomes real.

model Deal {
  id        String  @id @default(cuid())
  reference String  @unique // human-friendly code, e.g. POD-2026-0042

  clientId     String
  client       Client  @relation(fields: [clientId], references: [id])
  consultantId String?
  consultant   User?   @relation("ConsultantDeals", fields: [consultantId], references: [id])

  // Vehicle
  make           String
  model          String
  year           Int?
  registrationNo String?
  vin            String?
  colour         String?
  mileageKm      Int?

  // Route
  supplier           String?
  sourceCountry      String? // typically ZA
  destinationCountry String?
  destinationCity    String?

  // Money — cross-border, so currency is always explicit
  sellingPrice    Decimal? @db.Decimal(14, 2)
  sellingCurrency String?  @db.Char(3)
  costPrice       Decimal? @db.Decimal(14, 2) // internal only, role-gated in API
  costCurrency    String?  @db.Char(3)
  fxRateSnapshot  Decimal? @db.Decimal(14, 6) // rate captured at deal time

  expectedDeliveryDate DateTime?

  // Denormalised snapshots for a fast board; the timeline is the truth
  currentStatusId   String?
  currentStatus     DealStatus? @relation("CurrentStatus", fields: [currentStatusId], references: [id])
  currentLocationId String?
  currentLocation   Location?   @relation("CurrentLocation", fields: [currentLocationId], references: [id])

  // Pre-sale funnel; null once the car is actually in motion
  leadStage LeadStage?

  sageInvoiceId String? // Sage sales_invoice id, set when pushed

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  timeline      TimelineEvent[]
  payments      Payment[]
  media         MediaAsset[]
  documents     Document[]
  trackingLinks TrackingLink[]
  importRows    ImportRow[]
  notifications Notification[]
  assignments   Assignment[] // RTMS fleet module: trips moving this car

  @@index([clientId])
  @@index([consultantId])
  @@index([currentStatusId])
  @@index([currentLocationId])
  @@index([destinationCountry])
  @@index([updatedAt]) // powers stalled-deal nudges later
}

// Append-only. Never updated, never deleted — this is also the audit log.
model TimelineEvent {
  id     String       @id @default(cuid())
  dealId String
  deal   Deal         @relation(fields: [dealId], references: [id])
  type   TimelineType

  statusId   String?
  status     DealStatus? @relation(fields: [statusId], references: [id])
  locationId String?
  location   Location?   @relation(fields: [locationId], references: [id])

  note      String?
  meta      Json? // free-form payload (e.g. paymentId, documentId, import batch)
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([dealId, createdAt])
}

model Payment {
  id       String   @id @default(cuid())
  dealId   String
  deal     Deal     @relation(fields: [dealId], references: [id])
  amount   Decimal  @db.Decimal(14, 2)
  currency String   @db.Char(3)
  method   String? // bank transfer, cash, EcoCash… kept as text for import fidelity
  reference String?
  paidAt   DateTime
  note     String?

  sagePaymentId String? // Sage contact_payment id, set when pushed

  recordedById String?
  recordedBy   User?   @relation(fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([dealId])
}

model MediaAsset {
  id         String     @id @default(cuid())
  dealId     String
  deal       Deal       @relation(fields: [dealId], references: [id])
  kind       MediaKind
  bucket     String
  objectKey  String
  mimeType   String
  sizeBytes  Int
  caption    String?
  scanStatus ScanStatus @default(PENDING) // ClamAV verdict before anything is served

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@unique([bucket, objectKey])
  @@index([dealId])
}

model Document {
  id       String       @id @default(cuid())
  dealId   String
  deal     Deal         @relation(fields: [dealId], references: [id])
  type     DocumentType
  label    String? // free label when type = OTHER
  bucket   String?
  objectKey String?
  filename  String? // original filename of the uploaded file
  mimeType  String?
  sizeBytes Int?
  scanStatus ScanStatus @default(PENDING) // only meaningful once a file is attached
  visibleToClient Boolean @default(false) // shows up (and downloads) on the tracking page
  fromClient      Boolean @default(false) // uploaded by the customer via their link
  received Boolean      @default(false)
  note     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([dealId])
}

// ───────────────────────── Client tracking portal ─────────────────────────
// Phase 2 surface, but the schema ships now so nothing needs migrating later.

model TrackingLink {
  id           String    @id @default(cuid())
  token        String    @unique // long random URL token
  pinHash      String? // optional PIN, argon2 hash — never the PIN itself
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id])
  dealId       String?
  deal         Deal?     @relation(fields: [dealId], references: [id])
  showPrices   Boolean   @default(false) // "You choose whether the customer sees these figures"
  expiresAt    DateTime?
  revokedAt    DateTime?
  lastAccessAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([clientId])
}

// Every outbound message (WhatsApp or internal nudge), whatever the provider.
// In log mode the row IS the demo: status LOGGED shows exactly what would go out.
model Notification {
  id                String              @id @default(cuid())
  dealId            String?
  deal              Deal?               @relation(fields: [dealId], references: [id])
  clientId          String?
  client            Client?             @relation(fields: [clientId], references: [id])
  channel           NotificationChannel
  toPhone           String?
  template          String?
  body              String
  status            NotificationStatus  @default(PENDING)
  providerMessageId String?
  error             String?
  createdAt         DateTime            @default(now())
  sentAt            DateTime?

  @@index([dealId])
  @@index([createdAt])
}

// Sage Business Cloud OAuth tokens — single row, rotated on every refresh.
model SageToken {
  id           Int      @id @default(1)
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  businessName String?
  connectedBy  String?
  updatedAt    DateTime @updatedAt
}

// Raw inbound WhatsApp messages (two-way flow). Kept verbatim for audit.
model InboundMessage {
  id        String   @id @default(cuid())
  fromPhone String
  body      String
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])
  handled   Boolean  @default(false)
  reply     String?
  raw       Json?
  createdAt DateTime @default(now())

  @@index([fromPhone])
}

// ─────────────────────────── Guided Excel importer ───────────────────────────
// upload -> detect sheets -> map columns -> normalise -> preview & resolve -> commit
// Nothing is silently guessed; every ambiguity becomes a NEEDS_REVIEW row.

model ImportBatch {
  id           String            @id @default(cuid())
  filename     String
  bucket       String?
  objectKey    String?
  status       ImportBatchStatus @default(UPLOADED)
  sheetName    String?
  columnMap    Json? // spreadsheet column -> system field mapping, human-confirmed
  uploadedById String?
  uploadedBy   User?             @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime          @default(now())
  committedAt  DateTime?

  rows ImportRow[]
}

model ImportRow {
  id       String          @id @default(cuid())
  batchId  String
  batch    ImportBatch     @relation(fields: [batchId], references: [id])
  rowIndex Int
  raw      Json // untouched cells, kept forever for traceability
  mapped   Json? // normalised candidate record
  issues   Json? // [{field, problem, suggestion}] e.g. implausible dates, mixed phone formats
  status   ImportRowStatus @default(PENDING)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id])

  @@unique([batchId, rowIndex])
}

// ═══════════════════════════════════════════════════════════════════════════
//                    RTMS FLEET & COMPLIANCE MODULE
// ═══════════════════════════════════════════════════════════════════════════
// Additive module making POD auditable against RTMS (SANS 1395, 8 elements).
//
// Distinct from the imported-car `Deal`: an `Asset` is a truck POD OWNS, a
// `Deal` is a car POD SELLS. `Assignment` is the only bridge between them.
//
// Design rules mirroring the core schema:
//   1. Everything that expires is a ComplianceItem — one reminders engine, one
//      RAG rollup, driven off `expiresOn`. Expiry dates are never scattered
//      across models.
//   2. Statuses / checklist items / compliance kinds are lookup tables, not
//      enums, because admins keep editing them (same reason as DealStatus).
//   3. FleetEvent is append-only, exactly like TimelineEvent. TimelineEvent
//      itself cannot be reused: its `dealId` is required and FK'd to Deal.
//   4. References to `User` and `FleetFile` are plain id columns rather than
//      Prisma relations, deliberately — it keeps the existing User model
//      untouched (back-relations would add 13 fields to it). Services resolve
//      the names via batch lookup. Deal is the ONLY existing model edited.

// ─────────────────────── Fleet enums (logic-bearing) ───────────────────────
// These stay enums because code branches on them; the admin-editable lists
// are the lookup *tables* further down.

enum ComplianceOwnerType {
  ASSET
  DRIVER
}

// DERIVED, never hand-set: recomputed daily from expiresOn by the engine.
enum ComplianceStatus {
  VALID
  DUE_SOON
  EXPIRED
}

// The 8 RTMS elements — every record that proves something maps to one, so
// the RAG dashboard can group by element.
enum RtmsElement {
  MANAGEMENT_COMMITMENT // 1
  RISK_MANAGEMENT       // 2
  VEHICLE_FITNESS       // 3
  DRIVER_WELLNESS       // 4
  LOAD_MANAGEMENT       // 5
  JOURNEY_MANAGEMENT    // 6
  INCIDENT_MANAGEMENT   // 7
  MONITORING_REVIEW     // 8
}

// P5: "an X will be marked in either the Yes or No column". The form has
// no third state, so neither does the model.
enum InspectionAnswer {
  YES
  NO
}

enum CorrectiveActionStatus {
  OPEN
  IN_PROGRESS
  DONE
  VERIFIED
}

// Outcome of the compliance-aware assignment gate.
enum GateDecision {
  PASS
  WARN // departed with an unresolved advisory a human accepted
  FAIL
  OVERRIDDEN
}

enum TyreAction {
  FITTED
  ROTATED
  REPAIRED
  REPLACED
  SCRAPPED
}

enum FineStatus {
  UNPAID
  PAID
  CONTESTED
  WRITTEN_OFF
}

enum AuditPackStatus {
  PENDING
  BUILDING
  READY
  FAILED
}

// What a FleetFile is attached to — drives bucket prefix and retention.
enum FleetFileKind {
  COMPLIANCE_DOC
  INSPECTION_PHOTO
  INCIDENT_PHOTO
  POD_SIGNATURE
  POD_PHOTO
  WORK_ORDER_DOC
  MASS_CERTIFICATE
  POLICY_DOC
  REPORT_PDF
}

// FleetEvent is polymorphic across the module's entities.
enum FleetEntityType {
  ASSET
  DRIVER
  WORK_ORDER
  INSPECTION
  ASSIGNMENT
  INCIDENT
  COMPLIANCE_ITEM
  CARRIER
}

enum FleetEventType {
  STATUS_CHANGE
  NOTE
  DOCUMENT
  SYSTEM
  GATE_CHECK
  GATE_OVERRIDE
  INVESTIGATION
  CORRECTIVE_ACTION
  COMPLIANCE_CHANGE
}

// P3: "accidents will be categorized according to driver fault or 3rd fault etc."
enum FaultCategory {
  DRIVER_FAULT
  THIRD_PARTY_FAULT
  SHARED
  UNDETERMINED
}

// Where an R9 corrective action came from. The manual routes fatigue
// breaches, accident findings, audit findings and fine trends all here.
enum CorrectiveActionSource {
  INCIDENT
  AUDIT_FINDING
  FINE
  FATIGUE_BREACH
  INSPECTION
  OTHER
}

// Internal audit outcome per RTMS element.
enum AuditConformity {
  CONFORMS
  MINOR_NON_CONFORMANCE
  MAJOR_NON_CONFORMANCE
  OBSERVATION
}

// ───────────────────── Lookup tables (admin-editable) ─────────────────────
// Seeded, then owned by admins — mirroring how DealStatus / Location work.

model AssetType {
  id        String  @id @default(cuid())
  code      String  @unique // TRUCK_TRACTOR, CAR_CARRIER, TRAILER…
  name      String
  isTrailer Boolean @default(false)
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  assets Asset[]
}

// The heart of the module's configurability: every kind of thing that expires.
// `requiredForOperation` is what the assignment gate reads — admins decide
// which documents actually block a trip, without a code change.
model ComplianceKind {
  id                   String              @id @default(cuid())
  code                 String              @unique // VEHICLE_LICENCE, COF, CBRTA_PERMIT, DRIVER_LICENCE, PRDP, MEDICAL, SERVICE_DUE…
  name                 String
  ownerType            ComplianceOwnerType
  leadDaysDueSoon      Int                 @default(30) // configurable reminder lead time
  requiredForOperation Boolean             @default(false) // blocks the gate when not VALID
  rtmsElement          RtmsElement?
  sortOrder            Int                 @default(0)
  active               Boolean             @default(true)

  items ComplianceItem[]

  @@index([ownerType, active])
}

model WorkOrderStatus {
  id         String  @id @default(cuid())
  code       String  @unique // REQUESTED, APPROVED, IN_PROGRESS, AWAITING_PARTS, DONE, CLOSED
  name       String
  sortOrder  Int     @default(0)
  isTerminal Boolean @default(false)
  active     Boolean @default(true)

  workOrders WorkOrder[]
}

model TripStatus {
  id         String  @id @default(cuid())
  code       String  @unique // PLANNED, GATE_BLOCKED, IN_PROGRESS, DELIVERED, CANCELLED
  name       String
  sortOrder  Int     @default(0)
  isTerminal Boolean @default(false)
  active     Boolean @default(true)

  assignments Assignment[]
}

model IncidentStatus {
  id         String  @id @default(cuid())
  code       String  @unique // REPORTED, INVESTIGATING, ACTIONS_OPEN, CLOSED
  name       String
  sortOrder  Int     @default(0)
  isTerminal Boolean @default(false)
  active     Boolean @default(true)

  incidents Incident[]
}

model IncidentSeverity {
  id        String  @id @default(cuid())
  code      String  @unique // MINOR, SERIOUS, MAJOR, FATAL
  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  incidents Incident[]
}

model IncidentCategory {
  id        String  @id @default(cuid())
  code      String  @unique // COLLISION, ROLLOVER, LOAD_SHIFT, NEAR_MISS, INJURY…
  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  incidents Incident[]
}

// The daily pre-trip checklist, editable by admins rather than hardcoded.
model InspectionItemDef {
  id        String  @id @default(cuid())
  code      String  @unique // TYRES, BRAKES, LIGHTS, COUPLING, LOAD_SECURING…
  label     String
  category  String? // grouping on the mobile form, e.g. "Under the bonnet"
  critical  Boolean @default(false) // a failed critical item blocks departure
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  results InspectionResult[]
}

// ─────────────────────────── Files (MinIO + ClamAV) ───────────────────────────
// Document/MediaAsset both require a dealId, so the fleet module needs its own
// blob table. Same StorageService + ClamAvService, same rule: only CLEAN files
// are ever served.

model FleetFile {
  id           String        @id @default(cuid())
  kind         FleetFileKind
  bucket       String
  objectKey    String
  filename     String?
  mimeType     String
  sizeBytes    Int
  scanStatus   ScanStatus    @default(PENDING) // reuses the core ScanStatus enum
  uploadedById String? // User.id — plain column, see header note
  createdAt    DateTime      @default(now())

  @@unique([bucket, objectKey])
  @@index([kind])
}

// ─────────────────────────── Assets & drivers ───────────────────────────

// A vehicle POD owns and operates. NOT a Deal car.
model Asset {
  id      String @id @default(cuid())
  // Columns below are R1 Fleet List, in R1's order and wording.
  fleetNo          String  @unique // R1 "No" — also R11/R12 "Fleet Nr"
  yearModel        Int? // R1 "Year Model"
  makeManufacturer String? // R1 "Make/Manufacturer"
  registrationNo   String  @unique // R1 "Vehicle Registration Number"
  vin              String? // R1 "Vehicle Identification Number (VIN)"
  typeId           String
  type             AssetType @relation(fields: [typeId], references: [id]) // R1 "Vehicle Type"
  maxLoadingMassKg Int // R1 "Maximum Loading Mass" — stored kg, printed in tonnes
  maxPassengers    Int? // R1 "Maximum Number of Passengers" — null prints "N/A"
  comments         String? // R1 "Comments"

  // Not on R1, but R11 needs it to compute a km-based service interval.
  odometerKm Int      @default(0)
  active     Boolean  @default(true)
  retiredAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  complianceItems  ComplianceItem[]
  maintenancePlans MaintenancePlan[]
  workOrders       WorkOrder[]
  inspections      Inspection[]
  assignments      Assignment[]
  massRecords      TripMassRecord[]
  incidents        Incident[]
  fines            Fine[]
  tyreRecords      TyreRecord[]
  speedTrends      SpeedTrend[]

  @@index([active])
  @@index([typeId])
}

model Driver {
  id String @id @default(cuid())
  // R15 and R16 both key on the employee and split the name into two columns.
  employeeNo       String  @unique // R15 "Employee No."
  surname          String // R15/R16 "Surname"
  firstName        String // R15/R16 "Name"
  chronicCondition String? // R15 "Chronic condition"
  comments         String? // R16 "Comments"

  phoneE164 String?
  email     String?
  userId    String? // optional link to a User account — plain column
  active    Boolean   @default(true)
  hiredOn   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Licence number/issue/expiry (R16) and medical last-test/next-visit (R15)
  // are ComplianceItems, not columns here — one expiry engine, one RAG.
  complianceItems   ComplianceItem[]
  assignments       Assignment[]
  inspections       Inspection[]
  incidents         Incident[]
  fines             Fine[]
  dutyRecords       DriverDutyRecord[]
  routeAcks         RouteAcknowledgement[]
  policyAcks        PolicyAcknowledgement[]
  speedTrends       SpeedTrend[]
  trainingRecords   TrainingRecord[]
  correctiveActions CorrectiveAction[]

  @@index([active])
  @@index([surname, firstName])
}

// ══════════════════ THE CORE PRIMITIVE ══════════════════
// Every expiring fact in the system — vehicle licence, COF, CBRTA permit,
// driver licence, PrDP, medical, service due, policy ack — is one of these.
// `status` is DERIVED from expiresOn by the daily engine and persisted so it
// stays indexable/queryable; nothing else may write it.
//
// The brief's {ownerType, ownerId} is refined into ownerType + nullable
// assetId/driverId FKs: same semantics, but real referential integrity and
// working Prisma includes. Services enforce exactly-one-owner.
model ComplianceItem {
  id        String              @id @default(cuid())
  ownerType ComplianceOwnerType
  assetId   String?
  asset     Asset?              @relation(fields: [assetId], references: [id])
  driverId  String?
  driver    Driver?             @relation(fields: [driverId], references: [id])

  kindId String
  kind   ComplianceKind @relation(fields: [kindId], references: [id])

  reference String? // licence / permit / certificate number
  issuedOn  DateTime?
  expiresOn DateTime? // null = does not expire; engine treats as VALID

  status           ComplianceStatus @default(VALID) // DERIVED — engine-owned
  statusComputedAt DateTime?

  documentFileId String? // FleetFile.id — the scan of the certificate
  notes          String?
  archivedAt     DateTime? // superseded by a renewal
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([ownerType, status])
  @@index([expiresOn])
  @@index([assetId])
  @@index([driverId])
  @@index([kindId])
}

// ─────────────────── Vehicle fitness (RTMS element 3) ───────────────────

// Interval by km AND/OR months — whichever falls first. The maintenance
// service materialises the resulting SERVICE_DUE ComplianceItem.
model MaintenancePlan {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])
  name    String @default("Routine service")

  intervalKm     Int?
  intervalMonths Int?

  lastServiceOdoKm Int?
  lastServiceDate  DateTime?

  // Computed by the service from last* + interval*; whichever comes first wins.
  nextDueOdoKm Int?
  nextDueDate  DateTime?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
}

model WorkOrder {
  id      String @id @default(cuid())
  number  String @unique // WO-2026-0001
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  statusId String
  status   WorkOrderStatus @relation(fields: [statusId], references: [id])

  title       String
  description String?
  odometerKm  Int?

  // Does this job affect whether the vehicle is safe and legal to operate?
  // Element 3 (vehicle fitness) counts only these. Without the distinction a
  // windscreen chip degraded fitness exactly as much as a brake defect, so
  // the element sat amber permanently and stopped carrying information.
  // Defaults false: existing jobs are routine until someone says otherwise.
  roadworthiness Boolean @default(false)

  partsCost  Decimal? @db.Decimal(12, 2)
  labourCost Decimal? @db.Decimal(12, 2)
  currency   String   @default("ZAR") @db.Char(3)
  supplier   String?

  // Lifecycle timestamps: REQUESTED→APPROVED→IN_PROGRESS→AWAITING_PARTS→DONE→CLOSED
  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  closedAt    DateTime?

  requestedById String? // User.id
  approvedById  String? // User.id

  documentFileId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // A failed pre-trip check that raised this job
  inspectionResults InspectionResult[]

  @@index([assetId])
  @@index([statusId])
}

// Daily pre-trip checklist. Optionally bound to the trip it clears.
model Inspection {
  id           String      @id @default(cuid())
  assetId      String
  asset        Asset       @relation(fields: [assetId], references: [id])
  driverId     String?
  driver       Driver?     @relation(fields: [driverId], references: [id])
  assignmentId String?     @unique
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])

  // P5: "all the required details completed (e.g., fleet number, vehicle
  // registration, drivers name, trip information, required signatures)"
  tripInformation String?
  performedAt     DateTime @default(now())
  odometerKm      Int?
  passed          Boolean  @default(true) // derived: no NO answers

  // P5 requires two signatures: the driver signs the sheet, and once a
  // defect has been addressed it is signed off again to confirm the vehicle
  // is safe to proceed.
  driverSignatureFileId    String?
  reportedToController     Boolean   @default(false)
  defectsClearedAt         DateTime?
  clearedById              String? // User.id
  clearedBySignatureFileId String?

  notes     String?
  createdAt DateTime @default(now())

  results InspectionResult[]

  @@index([assetId, performedAt])
}

model InspectionResult {
  id           String            @id @default(cuid())
  inspectionId String
  inspection   Inspection        @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  itemId       String
  item         InspectionItemDef @relation(fields: [itemId], references: [id])

  // P5: "an X will be marked in either the Yes or No column".
  answer      InspectionAnswer
  note        String?
  photoFileId String?

  // A NO can raise a work order so the defect cannot be found and then lost.
  workOrderId String?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@unique([inspectionId, itemId])
  @@index([itemId])
}

model TyreRecord {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id]) // R12 "Fleet Nr" + "Vehicle Reg. No."

  date                   DateTime @default(now())
  tyreFitted             String // R12 "Tyre fitted e.g., Goodyear 385"
  reasonForFitment       String? // R12 "Reason for fitment"
  tyrePosition           String // R12 "Tyre position e.g., Left front"
  // Manual 4.10: "This record also keeps a record of wheel balancing and
  // alignment, which is critical part of ensuring tyre safety."
  balancingAlignmentDone Boolean?
  comments               String? // R12 "Comments"
  createdAt              DateTime @default(now())

  @@index([assetId])
}

// ─────────────── Risk management (RTMS element 2) ───────────────

model RiskAssessment {
  id          String       @id @default(cuid())
  title       String
  scope       String?
  rtmsElement RtmsElement?
  version     Int          @default(1)
  assessedOn  DateTime
  reviewDueOn DateTime?
  assessedById String? // User.id
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  hazards Hazard[]
  // R6 is a separate register in the toolkit, not a child of R5 — no relation.
}

model Hazard {
  id               String         @id @default(cuid())
  riskAssessmentId String
  riskAssessment   RiskAssessment @relation(fields: [riskAssessmentId], references: [id], onDelete: Cascade)

  // R5 is exactly three columns. It carries no likelihood/severity scoring,
  // so none is invented here — the register would not match the form.
  hazardIdentified String // R5 "Hazards identified"
  impact           String // R5 "Impact"
  existingControls String? // R5 "Existing controls"
  sortOrder        Int     @default(0)

  @@index([riskAssessmentId])
}

// A route a driver must acknowledge before departure (element 6 + 2).
model RouteRiskAssessment {
  id   String @id @default(cuid())
  name String

  // R6 is a narrative briefing sheet, not a hazard table. Each heading on
  // the form is one field, in the form's order.
  routeHazards          String? // "ROUTE HAZARDS:"
  siteEntryInstructions String? // "SITE ENTRY INSTRUCTIONS:"
  siteHazards           String? // "SITE HAZARDS:"
  siteExitInstructions  String? // "SITE EXIT INSTRUCTIONS:"
  returnJourney         String? // "RETURN JOURNEY:"
  specialInstructions   String? // "SPECIAL INSTRUCTIONS:"
  emergencyContacts     String? // "EMERGENCY CONTACT NUMBERS;"

  // Reuses the EXISTING Location lookup by id — plain columns, so the
  // Location model needs no back-relation fields.
  originLocationId      String?
  destinationLocationId String?

  version     Int       @default(1) // a bump invalidates prior acknowledgements
  reviewDueOn DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  acknowledgements RouteAcknowledgement[]
  assignments      Assignment[]
}

model RouteAcknowledgement {
  id                    String              @id @default(cuid())
  routeRiskAssessmentId String
  route                 RouteRiskAssessment @relation(fields: [routeRiskAssessmentId], references: [id], onDelete: Cascade)
  driverId              String
  driver                Driver              @relation(fields: [driverId], references: [id])

  version         Int // the route version acknowledged; gate compares to current
  acknowledgedAt  DateTime @default(now())
  signatureFileId String?

  @@unique([routeRiskAssessmentId, driverId, version])
  @@index([driverId])
}

// ─────────────── Journey management (RTMS element 6) ───────────────

// External haulier register.
model Carrier {
  id          String  @id @default(cuid())
  name        String  @unique
  contactName String?
  phoneE164   String?
  email       String?
  fleetSize   Int?
  routes      String? // free text: routes they cover
  ratePerKm   Decimal? @db.Decimal(12, 2)
  currency    String   @default("ZAR") @db.Char(3)
  complianceNotes String?
  active      Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments Assignment[]
}

// The Trip. The ONE bridge between the fleet module and the existing Deal.
model Assignment {
  id        String @id @default(cuid())
  reference String @unique // TRIP-2026-0001

  // The car being moved — optional, since repositioning trips carry no deal.
  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id])

  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id])
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  carrierId String?
  carrier   Carrier? @relation(fields: [carrierId], references: [id])

  statusId String
  status   TripStatus @relation(fields: [statusId], references: [id])

  originLocationId      String? // Location.id — see RouteRiskAssessment note
  destinationLocationId String?

  routeRiskAssessmentId String?
  route                 RouteRiskAssessment? @relation(fields: [routeRiskAssessmentId], references: [id])

  plannedDepartureAt DateTime?
  actualDepartureAt  DateTime?
  plannedArrivalAt   DateTime?
  actualArrivalAt    DateTime?
  distanceKm         Int?

  // Proof of delivery capture (mobile)
  podCapturedAt      DateTime?
  podReceivedByName  String?
  podSignatureFileId String?
  podNotes           String?

  // Compliance-aware gate outcome; per-check reasons live in gateChecks
  gateDecision       GateDecision?
  gateCheckedAt      DateTime?
  gateOverrideReason String?
  gateOverriddenById String? // User.id — ADMIN only

  // An advisory (an unweighed load) blocks departure until someone accepts it
  // in writing. Kept separate from the override above so the register can tell
  // "we knew it was unweighed and went anyway" from "we bypassed a hard
  // failure" — an auditor treats those very differently.
  gateWarnAckAt     DateTime?
  gateWarnAckById   String? // User.id
  gateWarnAckReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  legs        AssignmentLeg[]
  gateChecks  AssignmentGateCheck[]
  massRecords TripMassRecord[]
  inspection  Inspection?
  incidents   Incident[]
  fines       Fine[]
  speedTrends SpeedTrend[]

  @@index([dealId])
  @@index([assetId])
  @@index([driverId])
  @@index([statusId])
  @@index([plannedDepartureAt])
}

model AssignmentLeg {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  sequence     Int

  fromLocationId String?
  toLocationId   String?
  plannedAt      DateTime?
  arrivedAt      DateTime?
  distanceKm     Int?
  notes          String?

  @@unique([assignmentId, sequence])
}

// Persisted per-check gate result, so a blocked trip shows exactly WHY and an
// override is auditable against the specific failures it bypassed.
model AssignmentGateCheck {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  code      String // DRIVER_LICENCE, ASSET_COF, FATIGUE_DAILY, MASS_LIMIT…
  label     String
  passed    Boolean
  // Passed, but on an unanswered question rather than a satisfied one — an
  // unweighed load, a night departure. The gate has always computed this;
  // it used to be dropped on the way to the database, so a warning and a
  // genuine pass were indistinguishable once persisted.
  advisory  Boolean  @default(false)
  detail    String? // human-readable reason when failed
  checkedAt DateTime @default(now())

  @@index([assignmentId])
}

// ─────────────── Load management (RTMS element 5) ───────────────

model TripMassRecord {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assetId      String
  asset        Asset      @relation(fields: [assetId], references: [id]) // R3 "Vehicle Reg No"

  date             DateTime // R3 "Date"
  // R3 has one column, "Mass Loaded/Passengers Loaded" — a vehicle carries
  // freight or people, so both are optional and the report prints whichever
  // was captured.
  massLoadedKg     Int?
  passengersLoaded Int?
  overloaded       Boolean // R3 "Overloaded (Yes/No)" — derived on write
  // Snapshot of the limit the decision was made against, so the evidence
  // stands even if the vehicle is re-rated later. Not printed on R3.
  permissibleMaxKg    Int?
  permissiblePassengers Int?

  comments       String?
  documentFileId String? // weighbridge ticket etc. (manual 4.4 "evidence")
  createdAt      DateTime @default(now())

  @@index([assetId, date])
  @@index([date]) // powers the R4 monthly rollup
}

// ─────────────── Driver wellness / fatigue (RTMS element 4) ───────────────
// Feeds the gate's three fatigue rules: max 15h/day, 90h per rolling 7 days,
// 30-min break each 4h of driving.

model DriverDutyRecord {
  id       String @id @default(cuid())
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id])

  assignmentId String?

  onDutyAt        DateTime
  offDutyAt       DateTime?
  drivingMinutes  Int      @default(0)
  breakMinutes    Int      @default(0)
  notes           String?
  createdAt       DateTime @default(now())

  @@index([driverId, onDutyAt])
}

// ─────────────── Incident management (RTMS element 7) ───────────────

model Incident {
  id        String @id @default(cuid())
  reference String @unique // INC-2026-0001
  date      DateTime // R8 "Date"

  assetId      String?
  asset        Asset?      @relation(fields: [assetId], references: [id]) // R8 "Vehicle Reg. No."
  driverId     String?
  driver       Driver?     @relation(fields: [driverId], references: [id]) // R8 "Driver Name"
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])

  description String // R8 "Description of Incident/Accident"
  cause       String? // R8 "Cause of the incident/accident"

  categoryId String?
  category   IncidentCategory? @relation(fields: [categoryId], references: [id])
  statusId   String
  status     IncidentStatus    @relation(fields: [statusId], references: [id])

  // P3: "accidents will be categorized according to driver fault or 3rd
  // fault etc.; accidents will also be categorized according to severity."
  faultCategory FaultCategory?
  severityId    String?
  severity      IncidentSeverity? @relation(fields: [severityId], references: [id])

  // Manual 4.8: near misses are captured in R8 too, "used as learning".
  isNearMiss Boolean @default(false)

  // P3: report to SAPS within 24 hours and obtain an accident report number.
  sapsReportNumber String?
  sapsReportedAt   DateTime?

  // P3: "The root cause of all incidents/accidents will be derived to ensure
  // effective preventative actions and learning points."
  immediateCause  String?
  underlyingCause String?
  systemicCause   String?

  locationText       String?
  injuries           Int     @default(0)
  vehicleDamage      Boolean @default(false)
  thirdPartyInvolved Boolean @default(false)

  reportedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  photos  IncidentPhoto[]
  actions CorrectiveAction[]

  @@index([date])
  @@index([assetId])
  @@index([driverId])
  @@index([statusId])
}

model IncidentPhoto {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  fileId     String // FleetFile.id
  caption    String?
  createdAt  DateTime @default(now())

  @@index([incidentId])
}

// R9 Corrective Action Register. The manual routes several different
// failures here — fatigue non-compliance (4.7), accident findings (4.8),
// traffic-fine trends (4.9) — so this is one register with a typed source
// rather than a child table of Incident.
model CorrectiveAction {
  id         String                 @id @default(cuid())
  sourceType CorrectiveActionSource

  incidentId     String?
  incident       Incident?     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  auditFindingId String?
  auditFinding   AuditFinding? @relation(fields: [auditFindingId], references: [id], onDelete: Cascade)
  fineId         String?
  fine           Fine?         @relation(fields: [fineId], references: [id], onDelete: Cascade)
  inspectionId   String?
  // Fatigue breaches attach to the driver, not to a document.
  driverId       String?
  driver         Driver?       @relation(fields: [driverId], references: [id])

  description  String
  ownerUserId  String?
  dueDate      DateTime?
  status       CorrectiveActionStatus @default(OPEN)
  completedAt  DateTime?
  verifiedById String?
  notes        String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([sourceType])
  @@index([status])
  @@index([dueDate])
  @@index([incidentId])
}

// Traffic-fine register (report R10).
model Fine {
  id         String   @id @default(cuid())
  date       DateTime // R10 "Date"
  assetId    String?
  asset      Asset?   @relation(fields: [assetId], references: [id]) // R10 "Vehicle Reg. No."
  driverId   String?
  driver     Driver?  @relation(fields: [driverId], references: [id]) // R10 "Driver Name"
  reason     String // R10 "What is the reason for the traffic fine"
  // Free-text summary as the form has it; the tracked work lives in the
  // shared CorrectiveAction register (R9), which links back here.
  correctiveActionsTaken String? // R10 "Corrective actions taken"

  noticeNumber   String? // not on R10; useful for filing the notice itself
  documentFileId String?
  assignmentId   String?
  assignment     Assignment? @relation(fields: [assignmentId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  correctiveActions CorrectiveAction[]

  @@index([assetId])
  @@index([driverId])
  @@index([date])
}

// Speed register (report R7) — telematics feed or manual capture.
model SpeedTrend {
  id       String  @id @default(cuid())
  date     DateTime // R7 "DATE"
  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id]) // R7 "DRIVER"
  assetId  String
  asset    Asset   @relation(fields: [assetId], references: [id]) // R7 "VEHICLE REG"

  // R7 asks the manager to describe the trend and what was done about it.
  // There is no speed/limit column, so no telematics numbers are modelled.
  speedTrend   String // R7 "DESCRIBE SPEED TREND"
  actionsTaken String? // R7 "ACTIONS TAKEN"

  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  createdAt    DateTime    @default(now())

  @@index([assetId, date])
  @@index([driverId])
}

// ─────────── Management commitment (element 1) & review (element 8) ───────────

// Versioned: a new version is a new row, the old one gets supersededAt.
model Policy {
  id          String   @id @default(cuid())
  code        String // SAFETY_POLICY, SUBSTANCE_POLICY, FATIGUE_POLICY…
  title       String
  body        String
  version     Int      @default(1)
  effectiveFrom DateTime
  supersededAt  DateTime?
  approvedById  String? // User.id
  rtmsElement   RtmsElement?
  documentFileId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  acknowledgements PolicyAcknowledgement[]

  @@unique([code, version])
}

model PolicyAcknowledgement {
  id       String  @id @default(cuid())
  policyId String
  policy   Policy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])
  userId   String? // User.id, for office staff

  acknowledgedAt  DateTime @default(now())
  signatureFileId String?

  @@index([policyId])
  @@index([driverId])
}

// Safety objectives & targets — the measurable half of element 1.
model SafetyObjective {
  id          String   @id @default(cuid())
  title       String
  metric      String // OVERLOADING_PCT, INCIDENT_RATE, COMPLIANCE_PCT…
  targetValue Decimal  @db.Decimal(12, 2)
  unit        String?
  periodStart DateTime
  periodEnd   DateTime
  actualValue Decimal? @db.Decimal(12, 2) // recomputed by the monthly rollup
  rtmsElement RtmsElement?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([periodStart])
}

// Auto monthly management review / safety performance report (element 8).
model ManagementReview {
  id          String   @id @default(cuid())
  periodMonth String   @unique // YYYY-MM
  generatedAt DateTime @default(now())
  metrics     Json // snapshot: RAG counts, overloading %, incidents, fines, service adherence
  notes       String?
  reviewedById String? // User.id
  reviewedAt   DateTime?
  documentFileId String? // FleetFile.id of the rendered PDF

  @@index([periodMonth])
}

// One "Export audit pack" action → the RTMS report set as PDFs.
model AuditPack {
  id          String          @id @default(cuid())
  requestedAt DateTime        @default(now())
  requestedById String? // User.id
  periodStart DateTime
  periodEnd   DateTime
  status      AuditPackStatus @default(PENDING)
  reports     Json? // which R-reports were included, and their file ids
  fileId      String? // FleetFile.id of the combined pack
  error       String?
  completedAt DateTime?

  @@index([status])
}

// ─────────────────────────── Append-only trail ───────────────────────────
// Same discipline as TimelineEvent (never updated, never deleted), but
// polymorphic — TimelineEvent itself is FK'd to a required dealId, so it
// cannot carry asset/driver/incident history.

model FleetEvent {
  id         String          @id @default(cuid())
  entityType FleetEntityType
  entityId   String
  type       FleetEventType

  note        String?
  meta        Json? // { workOrderId, gateChecks, previousStatus, … }
  createdById String? // User.id
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

// ─────────────── Driver training (manual 4.14, module M1) ───────────────
// "As a minimum the company will conduct defensive driver training on a
// bi-annual basis using the Defensive Driver Training Module M1."
// A completed record with a refresher interval materialises a TRAINING_DUE
// ComplianceItem, so training expiry runs through the same engine as a
// licence — no second reminder path.

model TrainingCourse {
  id              String  @id @default(cuid())
  code            String  @unique // "M1"
  name            String
  refresherMonths Int? // null = one-off, never expires
  description     String?
  active          Boolean @default(true)
  sortOrder       Int     @default(0)

  records TrainingRecord[]
}

model TrainingRecord {
  id       String         @id @default(cuid())
  courseId String
  course   TrainingCourse @relation(fields: [courseId], references: [id])
  driverId String
  driver   Driver         @relation(fields: [driverId], references: [id])

  completedOn       DateTime
  expiresOn         DateTime? // computed from course.refresherMonths
  trainerName       String?
  outcome           String? // pass / score / competency note
  certificateFileId String?
  notes             String?
  createdAt         DateTime @default(now())

  @@index([driverId])
  @@index([courseId])
}

// ─────────────── Internal audit (RTMS element 8) ───────────────
// The scheduled self-audit that feeds the management review. Findings raise
// rows in the shared R9 corrective action register.

model Audit {
  id           String    @id @default(cuid())
  reference    String    @unique // AUD-2026-01
  scheduledFor DateTime
  conductedOn  DateTime?
  auditorName  String?
  scope        String?
  summary      String?
  closedAt     DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  findings AuditFinding[]

  @@index([scheduledFor])
}

model AuditFinding {
  id      String @id @default(cuid())
  auditId String
  audit   Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)

  // Findings are filed against an RTMS element so the RAG dashboard can
  // show "element 5 has an open major non-conformance".
  rtmsElement RtmsElement
  conformity  AuditConformity
  description String
  evidence    String?
  createdAt   DateTime        @default(now())

  correctiveActions CorrectiveAction[]

  @@index([auditId])
  @@index([rtmsElement])
}
