# ─────────────────────────────────────────────────────────────────────
# POD — production environment. Copy to .env next to
# docker-compose.prod.yml and fill in every ?required value.
# ─────────────────────────────────────────────────────────────────────

# Postgres
POSTGRES_USER=pod
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=pod

# Auth — REQUIRED. Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
JWT_EXPIRES_IN=12h

# Public URLs
# WEB_ORIGIN: where the web app is served (CORS + links in WhatsApp messages)
# NEXT_PUBLIC_API_URL: where the BROWSER reaches the API (baked at build time)
WEB_ORIGIN=https://pod.example.com
NEXT_PUBLIC_API_URL=https://api.pod.example.com

# MinIO (media storage)
MINIO_ROOT_USER=pod
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_password
S3_BUCKET_MEDIA=pod-media

# Meilisearch
MEILI_MASTER_KEY=CHANGE_ME_strong_key

# ── WhatsApp (Stage 2/3) ──────────────────────────────────────────────
# log  = record every message as a Notification row, send nothing (default)
# meta = send for real via Meta WhatsApp Cloud API
# To go live: create a Meta Business app → WhatsApp → get a permanent
# token + phone number ID, set the three values below, set MODE=meta,
# and point the app's webhook at  https://api.../api/whatsapp/webhook
# with the same verify token.
WHATSAPP_MODE=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=pod-verify-token

# ── Sage accounting (Stage 3) ────────────────────────────────────────
# CSV export works with no config. For direct push:
# 1. Register an app at developer.sage.com (Sage Accounting API v3.1)
# 2. Set the three values below; the redirect URI must EXACTLY match the
#    one registered with Sage and point at the API host.
# 3. On the Reports page, an admin presses "Connect Sage" and signs in.
# Tokens auto-refresh after that (Sage rotates refresh tokens; POD stores them).
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
SAGE_REDIRECT_URI=https://api.pod.example.com/api/accounting/sage/callback
# Optional fine-tuning (sensible defaults are auto-detected from the ledger):
# SAGE_SALES_LEDGER_CODE=4000   # nominal code of the sales account
# SAGE_TAX_RATE_ID=             # force a specific tax rate (else zero-rated/exempt is picked)
# SAGE_BANK_ACCOUNT_ID=         # bank account for customer receipts (else first account)

# ── Ops tuning (Stage 4) ─────────────────────────────────────────────
# A deal counts as stalled after this many days without movement.
STALLED_DAYS=7
# Units per 1 USD, used to normalise reports. Update as rates move.
FX_RATES_USD={"USD":1,"ZAR":18.5,"BWP":13.6,"MWK":1735,"MZN":64,"ZMW":26}
